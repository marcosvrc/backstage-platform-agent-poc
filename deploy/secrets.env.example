# Copie para deploy/secrets.env (não versionado) e preencha. Vira o Secret
# "<release>-env" pelo deploy/create-secrets.sh. Em produção, prefira gerar o
# Secret a partir do cofre da empresa (pipeline), com as mesmas chaves.
POSTGRES_PASSWORD=
# openssl rand -hex 32
BACKSTAGE_AUTH_SESSION_SECRET=
# Client "backstage" (login OIDC) no Keycloak
OIDC_CLIENT_SECRET=
# Client "backstage-catalog" (leitura do diretório) no Keycloak
KEYCLOAK_CATALOG_CLIENT_SECRET=
# GitHub App do catálogo
GITHUB_APP_CLIENT_SECRET=
# Virtual key do portal no LiteLLM
LITELLM_PORTAL_KEY=
