# Copie para github/.env (não versionado) e preencha com os dados do GitHub App.
# A chave privada do App vai em github/app-private-key.pem.
GITHUB_ORG=minha-empresa
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv23li...
GITHUB_APP_CLIENT_SECRET=
# Opcional: token para repositórios fora da organização (templates em conta pessoal).
# GITHUB_TOKEN=
