{
  "name": "@internal/backstage-plugin-agent-node",
  "description": "Contratos dos conectores do Platform Agent (gateway de IA, orçamento) e o ponto de extensão para registrá-los",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "node-library",
    "pluginId": "agent",
    "pluginPackages": [
      "@internal/backstage-plugin-agent",
