    {
      "username": "service-account-backstage-catalog",
      "enabled": true,
      "serviceAccountClientId": "backstage-catalog",
      "clientRoles": {
        "realm-management": [
          "query-groups",
          "query-users",
          "view-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "backstage",
      "name": "Backstage (login)",
      "description": "Login OIDC do portal. Segredo gerado pelo scripts/setup-keycloak.sh.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:7007/api/auth/oidc/handler/frame"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "acr",
        "web-origins"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "backstage-catalog",
      "name": "Backstage (leitura do diretório)",
      "description": "Conta de serviço que importa usuários e grupos para o catálogo.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles",
        "kc-admin-api"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "backstage-catalog",
        "roles": [
          "query-groups",
          "query-users",
          "view-users"
        ]
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "backstage",
      "roles": [
        "offline_access"
      ]
    }
  ]
}
